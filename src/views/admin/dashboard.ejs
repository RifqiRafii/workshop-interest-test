<%- include('../partials/head', { title: 'Dashboard Admin', adminHeader: true }) %>
<section class="dashboard-head"><div><p class="eyebrow">Rekap peserta</p><h1>Hasil tes minat.</h1></div><form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet" type="submit">Keluar</button></form></section>
<form class="filter-bar" method="get" action="/admin/dashboard"><label class="search-field">Cari nama atau program studi<input name="search" value="<%= filters.search %>" placeholder="Ketik pencarian..."></label><label>Bidang dominan<select name="dominant"><option value="">Semua bidang</option><option value="Algoritma & Pemrograman Dasar" <%= filters.dominant === 'Algoritma & Pemrograman Dasar' ? 'selected' : '' %>>Algoritma</option><option value="Website Dasar" <%= filters.dominant === 'Website Dasar' ? 'selected' : '' %>>Website</option><option value="UI/UX" <%= filters.dominant === 'UI/UX' ? 'selected' : '' %>>UI/UX</option><option value="SEIMBANG" <%= filters.dominant === 'SEIMBANG' ? 'selected' : '' %>>Seimbang</option></select></label><button class="button button-dark" type="submit">Filter</button></form>
<div class="table-wrap"><table><thead><tr><th>Nama</th><th>Program studi</th><th>Algoritma</th><th>Website</th><th>UI/UX</th><th>Dominan</th><th>Tanggal</th></tr></thead><tbody><% if (!participants.length) { %><tr><td colspan="7" class="empty-state">Belum ada hasil yang cocok.</td></tr><% } %><% participants.forEach((participant) => { %><tr><td><strong><%= participant.nama %></strong></td><td><%= participant.programStudi %></td><td><%= participant.hasil.skorAlgoritma %></td><td><%= participant.hasil.skorWebsite %></td><td><%= participant.hasil.skorUiux %></td><td><span class="dominant-tag"><%= participant.hasil.kategoriDominan %></span></td><td><%= participant.createdAt.toLocaleDateString('id-ID') %></td></tr><% }) %></tbody></table></div>
<%- include('../partials/foot') %>
