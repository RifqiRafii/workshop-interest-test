<%- include('../partials/head', { title: 'Login Admin', adminHeader: true }) %>
<section class="form-wrap narrow admin-login"><p class="eyebrow">Area panitia</p><h1>Login admin.</h1><p class="muted">Masuk untuk melihat rekap hasil peserta.</p><% if (error) { %><div class="alert alert-error"><%= error %></div><% } %><form method="post" action="/admin/login" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Username<input name="username" value="<%= username %>" maxlength="50" required autofocus></label><label>Password<input name="password" type="password" maxlength="200" required></label><button class="button button-primary" type="submit">Masuk ke Dashboard</button></form></section>
<%- include('../partials/foot') %>
